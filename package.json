{
  "name": "muffle",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "author": {
    "name": "Kaleidal",
    "email": "hello@kaleid.al"
  },
  "description": "A fast, expressive Spotify desktop client",
  "homepage": "https://muffle.kaleid.al",
  "keywords": ["spotify", "music", "sabine", "svelte"],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "sabine dev .",
    "build": "bun run check && bun run build:web",
    "build:web": "vite build",
    "bundle": "sabine bundle . --release --out bundle",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "preview": "vite preview",
    "dist": "bun run bundle"
  },
  "dependencies": {
    "@lantharos/sabine": "git+https://github.com/Lantharos/Sabine.git#v0.1.20"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "26.4.0",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "sharp": "0.35.4",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "trustedDependencies": ["sharp"]
}
